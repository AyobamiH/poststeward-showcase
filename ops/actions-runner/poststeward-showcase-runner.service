[Unit]
Description=PostSteward showcase isolated one-job GitHub Actions listener
StartLimitIntervalSec=60
StartLimitBurst=8
[Service]
ExecStart=%h/.local/share/poststeward-showcase-runner/listen.sh
ExecStop=-/usr/bin/docker stop -t 15 poststeward-showcase-job
Restart=always
RestartSec=8
[Install]
WantedBy=default.target
